{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Windows CPU: small train, resume and inference",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/debug_windows_cpu.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {"PYTHONUTF8": "1", "OMP_NUM_THREADS": "2", "MKL_NUM_THREADS": "2"}
    },
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {"PYTHONUTF8": "1", "OMP_NUM_THREADS": "2", "MKL_NUM_THREADS": "2"}
    }
  ]
}
